# Backend API base URL (Express server)
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Firebase Web API key from the same Firebase project used by the backend.
# Find it in Firebase console -> Project settings -> General -> Web API Key.
# Needed for the email/password sign-in form. Access-token sign-in works
# without it.
VITE_FIREBASE_API_KEY=
